#!/usr/bin/env python3
"""Host-side client for the knowledge-search API. Stdlib only."""

from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

TEXT_SUFFIXES = {
    ".txt", ".md", ".markdown", ".log", ".json", ".csv",
    ".yaml", ".yml", ".rst", ".org", ".tex",
}
ROOT = Path(__file__).resolve().parents[1]
HERMES_HOME = Path(os.environ.get("HERMES_HOME") or Path.home() / ".hermes")


def _load_env() -> None:
    """KS_* from $KS_ENV, the repo .env (server host), then ~/.hermes/.env (clients)."""
    for raw in (os.environ.get("KS_ENV"), ROOT / ".env", HERMES_HOME / ".env"):
        if not raw or not Path(raw).is_file():
            continue
        for line in Path(raw).read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            key, value = line.split("=", 1)
            if key.strip().startswith("KS_"):
                os.environ.setdefault(key.strip(), value.strip().strip("'\""))


def _api() -> tuple[str, str]:
    _load_env()
    base = os.environ.get("KS_API_URL", "http://127.0.0.1:9470").rstrip("/")
    key = os.environ.get("KS_API_KEY", "")
    if not key:
        sys.exit("KS_API_KEY is missing. Set it or create .env next to the repo.")
    return base, key


def _request(method: str, path: str, payload: object | None = None, query: dict | None = None) -> object:
    base, key = _api()
    url = base + path
    if query:
        url += "?" + urllib.parse.urlencode({k: v for k, v in query.items() if v is not None})
    data = None
    headers = {"Authorization": f"Bearer {key}", "Accept": "application/json"}
    if payload is not None:
        data = json.dumps(payload, ensure_ascii=False).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            raw = resp.read().decode("utf-8")
    except urllib.error.HTTPError as exc:
        detail = exc.read().decode("utf-8", errors="replace")
        sys.exit(f"HTTP {exc.code} {detail}")
    return json.loads(raw) if raw else {}


def _print(payload: object) -> None:
    json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
    sys.stdout.write("\n")


def _iter_files(root: Path) -> list[Path]:
    if root.is_file():
        return [root]
    found = []
    for path in sorted(root.rglob("*")):
        if path.is_file() and path.suffix.lower() in TEXT_SUFFIXES and not path.name.startswith("."):
            found.append(path)
    return found


def cmd_ingest(args: argparse.Namespace) -> None:
    root = Path(args.path).resolve()
    files = _iter_files(root)
    if not files:
        sys.exit(f"no text files under {root}")
    base = root if root.is_dir() else root.parent
    documents = []
    for path in files:
        text = path.read_text(encoding="utf-8", errors="replace")
        rel = str(path.relative_to(base)) if root.is_dir() else path.name
        documents.append(
            {
                "kind": args.kind,
                "title": path.name,
                "body": text,
                "path": rel,
                "source_id": rel,
                "tags": args.tag,
                "agent": args.agent,
            }
        )
    ingested = 0
    chunks = 0
    doc_ids: list[str] = []
    step = 20
    for i in range(0, len(documents), step):
        batch = documents[i : i + step]
        result = _request("POST", "/v1/documents/bulk", {"documents": batch})
        assert isinstance(result, dict)
        ingested += int(result.get("ingested", 0))
        chunks += int(result.get("chunks", 0))
        doc_ids.extend(result.get("doc_ids") or [])
    _print({"files": len(files), "ingested": ingested, "chunks": chunks, "doc_ids": doc_ids})


def cmd_put(args: argparse.Namespace) -> None:
    body = args.body
    if body is None:
        body = sys.stdin.read()
    if not body.strip():
        sys.exit("body is empty")
    payload = {
        "kind": args.kind,
        "title": args.title,
        "body": body,
        "tags": args.tag,
        "agent": args.agent,
        "session_id": args.session_id,
        "role": args.role,
        "source_id": args.source_id,
        "created_at": args.created_at,
    }
    _print(_request("POST", "/v1/documents", payload))


def cmd_search(args: argparse.Namespace) -> None:
    payload = {
        "query": args.query,
        "kind": args.kind or None,
        "tags": args.tag,
        "agent": args.agent,
        "session_id": args.session_id,
        "limit": args.limit,
    }
    _print(_request("POST", "/v1/search", payload))


def cmd_get(args: argparse.Namespace) -> None:
    _print(_request("GET", f"/v1/documents/{urllib.parse.quote(args.doc_id)}"))


def cmd_list(args: argparse.Namespace) -> None:
    _print(_request("GET", "/v1/documents", query={"kind": args.kind, "tag": args.tag, "limit": args.limit}))


def cmd_tag(args: argparse.Namespace) -> None:
    _print(_request("PATCH", f"/v1/documents/{urllib.parse.quote(args.doc_id)}/tags", {"add": args.add, "remove": args.remove}))


def cmd_delete(args: argparse.Namespace) -> None:
    _print(_request("DELETE", f"/v1/documents/{urllib.parse.quote(args.doc_id)}"))


def cmd_stats(_: argparse.Namespace) -> None:
    _print(_request("GET", "/v1/stats"))


def _common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--kind", default=None)
    parser.add_argument("--tag", action="append", default=[])
    parser.add_argument("--agent", default=None)


def main() -> None:
    parser = argparse.ArgumentParser(description="knowledge-search client")
    sub = parser.add_subparsers(dest="cmd", required=True)

    ingest = sub.add_parser("ingest", help="upload a text file or directory")
    ingest.add_argument("path")
    ingest.add_argument("--kind", default="file")
    ingest.add_argument("--tag", action="append", default=[])
    ingest.add_argument("--agent", default=None)
    ingest.set_defaults(func=cmd_ingest)

    put = sub.add_parser("put", help="write one document; body from --body or stdin")
    put.add_argument("--body", default=None)
    put.add_argument("--title", default=None)
    put.add_argument("--kind", default="knowledge")
    put.add_argument("--tag", action="append", default=[])
    put.add_argument("--agent", default=None)
    put.add_argument("--session-id", default=None)
    put.add_argument("--role", default=None)
    put.add_argument("--source-id", default=None)
    put.add_argument("--created-at", default=None)
    put.set_defaults(func=cmd_put)

    search = sub.add_parser("search", help="search Japanese text")
    search.add_argument("query")
    _common(search)
    search.add_argument("--session-id", default=None)
    search.add_argument("--limit", type=int, default=8)
    search.set_defaults(func=cmd_search)

    get = sub.add_parser("get", help="read one document")
    get.add_argument("doc_id")
    get.set_defaults(func=cmd_get)

    listing = sub.add_parser("list", help="list documents")
    listing.add_argument("--kind", default=None)
    listing.add_argument("--tag", default=None)
    listing.add_argument("--limit", type=int, default=20)
    listing.set_defaults(func=cmd_list)

    tag = sub.add_parser("tag", help="add or remove tags")
    tag.add_argument("doc_id")
    tag.add_argument("--add", action="append", default=[])
    tag.add_argument("--remove", action="append", default=[])
    tag.set_defaults(func=cmd_tag)

    stats = sub.add_parser("stats")
    stats.set_defaults(func=cmd_stats)

    delete = sub.add_parser("delete", help="delete one document and its chunks")
    delete.add_argument("doc_id")
    delete.set_defaults(func=cmd_delete)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
